{
  "name": "uploadtomydesktopfolder",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "latest",
    "eslint": "^10.4.1",
    "prettier": "^3.8.3"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@elysia/html": "^1.4.1",
    "elysia": "^1.4.28",
    "elysia-ip": "^1.1.0"
  },
  "scripts": {
    "build": "bun build --bundle index.ts --outfile upload.js --target bun",
    "start": "NODE_ENV=production bun run ./index.ts 2>&1 | tee -a desktop.log",
    "start:ps": "pwsh -Command \"bun run ./index.ts | Tee-Object -FilePath desktop.log -Append\"",
    "dev": "NODE_ENV=development bun run ./index.ts 2>&1 | tee -a desktop.dev.log"
  }
}
